# SDP — environment variables (example)
# Kopieer naar .env en pas waarden aan. Commit .env NOOIT.

# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://sdp:sdp@localhost:5432/sdp?schema=public"

# ─── API ────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"
NODE_ENV="development"

# JWT (Auth — vervangbaar zodra Digitale-ID wordt aangesloten)
JWT_SECRET="vervang-mij-met-een-lange-random-string-minimaal-32-tekens"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Auth provider keuze: 'email-password' | 'digitale-id' (later)
AUTH_PROVIDER="email-password"

# ─── Object storage (MinIO lokaal, S3 in productie) ────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="sdp-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ─── Email (Mailpit lokaal) ────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SDP <no-reply@sdp.local>"

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="SDP — Suriname Decentralisatie Platform"
