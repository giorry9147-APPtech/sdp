# SDP — productie environment template
# Kopieer naar .env (in productie-deployment) en vul daadwerkelijke waarden in.
# COMMIT NOOIT de echte .env naar git.

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=sdp_prod
POSTGRES_PASSWORD=GEBRUIK_OPENSSL_RAND_BASE64_32
POSTGRES_DB=sdp_prod
# Voor managed Postgres (bv. AWS RDS, Aiven): zet DATABASE_URL direct
# en laat POSTGRES_* leeg
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&sslmode=require"

# ─── API ──────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000

# JWT — gebruik: openssl rand -base64 48
JWT_SECRET=VERVANG_MIJ_MET_RANDOM_STRING_VAN_MINIMAAL_48_TEKENS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth provider: 'email-password' (MVP) | 'digitale-id' (later, OIDC)
AUTH_PROVIDER=email-password

# CORS — komma-gescheiden lijst van toegestane web-origins
WEB_ORIGIN=https://sdp.example.sr

# ─── Email (SMTP) ─────────────────────────────────────────
# Gebruik lokale SMTP relay of Postmark/SendGrid
SMTP_HOST=smtp.sdp.sr
SMTP_PORT=587
SMTP_USER=no-reply@sdp.sr
SMTP_PASS=VERVANG_MIJ
SMTP_FROM="SDP <no-reply@sdp.sr>"

# ─── Object storage (S3-compatible) ──────────────────────
# Voor lokaal datacenter: MinIO of Backblaze B2
# Voor cloud: AWS S3 in São Paulo of EU
S3_ENDPOINT=https://s3.sdp.sr
S3_REGION=us-east-1
S3_BUCKET=sdp-uploads-prod
S3_ACCESS_KEY=VERVANG_MIJ
S3_SECRET_KEY=VERVANG_MIJ
S3_FORCE_PATH_STYLE=true

# ─── Frontend (build-time) ────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.sdp.example.sr
NEXT_PUBLIC_APP_NAME="Suriname Decentralisatie Platform"

# ─── Backup ───────────────────────────────────────────────
# Doel-bucket voor encrypted dagelijkse backups
BACKUP_S3_BUCKET=sdp-backups-prod
BACKUP_RETENTION_DAYS=90
# GPG public key voor backup-encryptie (recipient e-mail)
BACKUP_GPG_RECIPIENT=ops@sdp.sr

# ─── Monitoring (optioneel) ───────────────────────────────
SENTRY_DSN=
GRAFANA_URL=
